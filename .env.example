# ---------------------------------------------------------------------------
# Inovexa Labs — environment
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, sitemap, OG images and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://inovexalabs.com

# Supabase — these two are safe to expose; access is governed by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose to the browser. Used for admin writes that must
# bypass RLS (e.g. contact-inquiry triage) and for storage uploads.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: disables public sign-ups on the admin login screen.
ADMIN_ALLOWED_EMAILS=

# Optional: hCaptcha / Turnstile secret for the contact form spam gate.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
